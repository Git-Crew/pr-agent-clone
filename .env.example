# Copy to .env.local and fill in. Never commit real values.

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of this deployment, no trailing slash. GitHub sends webhooks here and the runner uses it as
# its OIDC audience. For local development use a tunnel URL (e.g. cloudflared, smee).
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL (as set by the Neon integration on Vercel) also works.
POSTGRES_URL=postgresql://user:password@localhost:5432/agent_pr

# ── Sessions and encryption ─────────────────────────────────────────────────
# Signs session cookies. At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=
# Encrypts secrets at rest (AES-256-GCM). Exactly 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Who may create the GitHub App from /dashboard/setup in production (emails or GitHub logins, comma-separated).
ADMIN_EMAILS=

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Create an OAuth 2.0 Web client in Google Cloud Console. Redirect URI must be:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub App ──────────────────────────────────────────────────────────────
# Optional. Easiest: leave these empty and use the one-click setup at /dashboard/setup, which stores the
# App's credentials encrypted in the database. Values set here take precedence.
GITHUB_APP_ID=
# The app's URL name: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# Contents of the downloaded .pem. On one line, write newlines as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Same value as the App's webhook secret, at least 16 characters.
GITHUB_WEBHOOK_SECRET=

# ── Razorpay (paid plans, not live yet) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Observability ───────────────────────────────────────────────────────────
# The Usage page reads the database. It does not need either variable below.
# Bearer token for GET /api/metrics. Required in production, open when unset in development.
# Body is Prometheus text for the last 24 hours (gauges, so values can fall as the window moves).
GITCREW_SCRAPE_TOKEN=
# Collector base URL. Each finished agent phase is POSTed to <endpoint>/v1/traces as OTLP JSON.
# Leave empty to keep traces in GitCrew only as the Usage rows.
GITCREW_OTLP_ENDPOINT=

# ── Review models ───────────────────────────────────────────────────────────
# A prompt agent picks the provider and the model id on its pipeline step.
# The key is an installation secret, not an env var: ANTHROPIC_API_KEY, OPENAI_API_KEY, or XAI_API_KEY.
# The system prompt and the harness are their own settings.
# Hermes and OpenClaw run in the gitcrew-worker repo, not in this app.
# The worker clones the pull request and starts one container from the gitcrew-sandbox image.
GITCREW_WORKER_URL=
GITCREW_WORKER_SECRET=


